# ----------------------------------------------------------------------------
# MarjPanel Paket ortam değişkenleri - bu dosyayı .env olarak kopyalayıp doldurun.
# Coolify'da Environment Variables sekmesinden ekleyin.
# ----------------------------------------------------------------------------

# PostgreSQL (yerelde docker-compose 'postgres' servisi, Coolify'da iç URL)
POSTGRES_USER=paket
POSTGRES_PASSWORD=degistir_guclu_parola
POSTGRES_DB=paket
POSTGRES_HOST_PORT=5443
DATABASE_URL=postgresql://paket:degistir_guclu_parola@127.0.0.1:5443/paket

# Auth.js - `openssl rand -base64 32`
AUTH_SECRET=degistir_rastgele_32_bayt
AUTH_TRUST_HOST=true
# Uygulama taban adresi (prod: https://paket.alanadiniz.com)
APP_URL=http://localhost:3000

# Trendyol API anahtarlarını şifrelemek için anahtar - `openssl rand -base64 32`
# DEĞİŞTİRİLİRSE kayıtlı entegrasyonlar çözülemez; sabit tutun.
APP_ENCRYPTION_KEY=degistir_32_baytlik_sifreleme_anahtari

# /api/cron/senkron ucu için gizli anahtar. BOŞSA uç 401 döner.
CRON_SECRET=
# 1 = süreç içi zamanlayıcı (varsayılan). 0 = yalnız dış cron tetikler.
SENKRON_ZAMANLAYICI=1

# Profil görsellerinin yazıldığı dizin (Docker'da /app/uploads, volume şart).
GORSEL_DIZIN=./.uploads

# İlk şirket ve süper yönetici (seed) - kurulumdan sonra parolayı değiştirin.
SEED_SIRKET_AD=Demo Sirketi
SEED_ADMIN_TELEFON=05550000000
SEED_ADMIN_PAROLA=degistir_admin_parola
SEED_ADMIN_AD=Yönetici

# 1 = /kayit açık (şirketler kendi kendine kayıt olabilir). Boş/0 = kapalı.
KAYIT_ACIK=1

# Trendyol (sağlayıcı varsayılanları; entegrasyon başına `ayarlar.saatOfseti` ezer)
TRENDYOL_API_BASE=https://apigw.trendyol.com
# Saat dilimsiz metin tarihlere uygulanan ofset (epoch tarihler kaydırılmaz).
TRENDYOL_SIPARIS_SAAT_OFSETI=3

# N11 (REST; appkey/appsecret entegrasyon kaydında)
N11_API_BASE=https://api.n11.com

# Hepsiburada (merchantId/servis anahtarı/entegratör adı entegrasyon kaydında)
HEPSIBURADA_OMS_BASE=https://oms-external.hepsiburada.com
HEPSIBURADA_MPOP_BASE=https://mpop.hepsiburada.com/product

# idefix (vendorId/apiKey/apiSecret entegrasyon kaydında; test ortamı IP beyaz listesi ister)
IDEFIX_API_BASE=https://merchantapi.idefix.com

# Pazarama (OAuth2 client credentials; API key/secret entegrasyon kaydında)
PAZARAMA_API_BASE=https://isortagimapi.pazarama.com
PAZARAMA_TOKEN_URL=https://isortagimgiris.pazarama.com/connect/token

# Amazon SP-API — UYGULAMANIN LWA kimliği (Seller Central → Develop Apps).
# Satıcının refresh token'ı entegrasyon kaydında. Boşsa Amazon bağlantısı çalışmaz.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SPAPI_BASE=https://sellingpartnerapi-eu.amazon.com

NODE_ENV=development
